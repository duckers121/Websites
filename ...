:root {
  --midnight: #0b1020;
  --navy: #111b3c;
  --royal: #2f5ef7;
  --violet: #7c3aed;
  --cyan: #67e8f9;
  --gold: #f5c451;
  --paper: #f9fafb;
  --ink: #1f2937;
  --muted: #5b6475;
  --line: rgba(148, 163, 184, 0.22);
  --white: #ffffff;
  --shadow: 0 24px 60px rgba(15, 23, 42, 0.12);
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  font-family: "Inter", sans-serif;
  background: linear-gradient(180deg, #f7f8ff 0%, #eef4ff 50%, #f8fafc 100%);
  color: var(--ink);
  line-height: 1.6;
}

img {
  max-width: 100%;
  display: block;
}

img, svg { vertical-align: middle; }

a {
  text-decoration: none;
  color: inherit;
}

button, input, textarea {
  font: inherit;
}

.page-shell {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.page-shell::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(99, 102, 241, 0.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(99, 102, 241, 0.08) 1px, transparent 1px);
  background-size: 52px 52px;
  mask-image: radial-gradient(circle at center, black 50%, transparent 92%);
  pointer-events: none;
}

.container {
  width: min(1200px, calc(100% - 32px));
  margin: 0 auto;
  position: relative;
  z-index: 1;
}

.site-header {
  padding-top: 24px;
  position: relative;
  z-index: 2;
}

.nav-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 14px 20px;
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid rgba(148, 163, 184, 0.2);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border-radius: 999px;
  box-shadow: 0 12px 36px rgba(15, 23, 42, 0.06);
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-mark {
  width: 46px;
  height: 46px;
  border-radius: 18px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, var(--violet), var(--royal));
  color: var(--white);
  font-weight: 800;
  font-size: 1.3rem;
  box-shadow: 0 18px 34px rgba(79, 70, 229, 0.28);
}

.brand-copy {
  display: flex;
  flex-direction: column;
  line-height: 1.1;
}

.eyebrow {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: var(--violet);
  font-weight: 800;
}

.brand-copy strong {
  font-weight: 900;
  font-size: 1.04rem;
}

.main-nav {
  display: flex;
  align-items: center;
  gap: 28px;
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--muted);
}

.main-nav a {
  transition: color 0.2s ease;
}

.main-nav a:hover,
.main-nav a.active {
  color: var(--violet);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  padding: 0.9rem 1.5rem;
  font-weight: 800;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  border: 1px solid transparent;
}

.btn:hover { transform: translateY(-1px); }

.btn-primary {
  background: linear-gradient(135deg, var(--violet), var(--royal));
  color: var(--white);
  box-shadow: 0 16px 36px rgba(79, 70, 229, 0.26);
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.6);
  color: var(--ink);
  border-color: rgba(148, 163, 184, 0.2);
}

.btn-light {
  background: var(--white);
  color: var(--violet);
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.12);
  color: var(--white);
  border-color: rgba(255, 255, 255, 0.35);
}

.hero {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 52px;
  align-items: center;
  padding: 52px 0 80px;
}

.hero-copy h1 {
  font-size: clamp(2.8rem, 5vw, 5rem);
  line-height: 0.96;
  letter-spacing: -0.07em;
  margin: 20px 0 18px;
  color: var(--ink);
}

.gradient-text {
  display: inline-block;
  background: linear-gradient(135deg, #7c3aed 0%, #2563eb 50%, #22d3ee 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.pill, .kicker {
  display: inline-flex;
  align-items: center;
  padding: 0.55rem 1rem;
  border-radius: 999px;
  background: rgba(124, 58, 237, 0.08);
  border: 1px solid rgba(124, 58, 237, 0.18);
  color: var(--violet);
  font-size: 0.8rem;
  font-weight: 800;
  letter-spacing: 0.02em;
}

.kicker {
  padding: 0.5rem 0.8rem;
  margin-bottom: 16px;
}

.kicker.light {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.18);
  color: #e9d5ff;
}

.hero-copy p,
.lede,
.info-card p,
.photo-copy p,
.feature-box p,
.quote-box p,
.contact-card li,
.contact-card p,
.mini-card p {
  color: var(--muted);
  font-size: 1.04rem;
  line-height: 1.8;
}

.hero-copy > p {
  max-width: 620px;
  font-size: 1.1rem;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 30px;
}

.stats {
  display: flex;
  flex-wrap: wrap;
  gap: 30px;
  margin-top: 36px;
}

.stats div {
  min-width: 130px;
}

.stats strong {
  display: block;
  font-size: clamp(1.75rem, 2vw, 2.4rem);
  letter-spacing: -0.06em;
  color: var(--ink);
}

.stats span {
  display: block;
  color: var(--muted);
  margin-top: 5px;
  font-size: 0.82rem;
}

.hero-visual {
  position: relative;
}

.image-frame {
  position: relative;
  padding: 16px;
  border-radius: 32px;
  background: linear-gradient(135deg, rgba(124, 58, 237, 0.12), rgba(37, 99, 235, 0.08));
  box-shadow: var(--shadow);
}

.image-frame img {
  width: 100%;
  height: 560px;
  object-fit: cover;
  border-radius: 28px;
}

.floating-badge {
  position: absolute;
  left: 28px;
  bottom: -20px;
  display: flex;
  flex-direction: column;
  background: rgba(255, 255, 255, 0.96);
  border: 1px solid rgba(148, 163, 184, 0.18);
  box-shadow: 0 18px 35px rgba(15, 23, 42, 0.12);
  border-radius: 18px;
  padding: 16px 18px;
}

.floating-badge span {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: var(--violet);
  font-weight: 800;
}

.floating-badge strong {
  font-size: 1.55rem;
  color: var(--ink);
  letter-spacing: -0.05em;
}

.section {
  padding: 112px 0;
}

.section-heading {
  margin-bottom: 42px;
}

.section-heading.center {
  text-align: center;
}

.section-heading h2,
.split-layout h2,
.page-hero h1,
.cta-panel h2 {
  margin: 0;
  font-size: clamp(2.2rem, 4vw, 3.4rem);
  line-height: 1.05;
  letter-spacing: -0.06em;
  color: var(--ink);
}

.card-grid {
  display: grid;
  gap: 26px;
}

.three-up {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.info-card,
.photo-card,
.contact-card {
  background: rgba(255, 255, 255, 0.78);
  border: 1px solid var(--line);
  border-radius: 28px;
  box-shadow: 0 18px 42px rgba(15, 23, 42, 0.06);
}

.info-card {
  padding: 30px 26px;
}

.icon {
  width: 60px;
  height: 60px;
  border-radius: 18px;
  display: grid;
  place-items: center;
  font-size: 1.8rem;
  margin-bottom: 18px;
}

.gradient-purple {
  background: linear-gradient(135deg, rgba(124, 58, 237, 0.14), rgba(37, 99, 235, 0.12));
}

.gradient-cyan {
  background: linear-gradient(135deg, rgba(34, 211, 238, 0.18), rgba(59, 130, 246, 0.12));
}

.gradient-gold {
  background: linear-gradient(135deg, rgba(245, 196, 81, 0.18), rgba(249, 115, 22, 0.12));
}

.info-card h3,
.photo-copy h3,
.feature-box h3,
.mini-card span,
.contact-card h2 {
  margin: 0;
  color: var(--ink);
}

.info-card h3,
.photo-copy h3,
.feature-box h3 {
  font-size: 1.45rem;
  letter-spacing: -0.04em;
}

.dark-section {
  background: var(--midnight);
  color: var(--white);
}

.split-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 42px;
  align-items: center;
}

.split-layout h2,
.page-hero h1,
.cta-panel h2 {
  color: inherit;
}

.light {
  color: rgba(255,255,255,0.8) !important;
}

.feature-stack {
  display: flex;
  flex-direction: column;
  gap: 18px;
  margin-top: 26px;
}

.feature-box {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  border: 1px solid rgba(255,255,255,0.1);
  background: rgba(255,255,255,0.04);
  border-radius: 20px;
  padding: 18px 20px;
}

.feature-box span {
  flex-shrink: 0;
  display: grid;
  place-items: center;
  width: 50px;
  height: 50px;
  border-radius: 14px;
  background: rgba(124, 58, 237, 0.18);
  font-size: 1.4rem;
}

.feature-box h3,
.feature-box p {
  color: var(--white);
}

.mini-cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22px;
}

.mini-card {
  border-radius: 28px;
  padding: 26px 22px;
  min-height: 190px;
  border: 1px solid rgba(255,255,255,0.1);
}

.mini-card strong {
  display: block;
  font-size: 3rem;
  letter-spacing: -0.06em;
  line-height: 1;
  margin-bottom: 10px;
  color: var(--white);
}

.mini-card span {
  display: block;
  font-weight: 700;
  margin-bottom: 8px;
  color: var(--white);
}

.mini-card p {
  color: rgba(255,255,255,0.72);
  margin: 0;
}

.mini-card.purple {
  background: linear-gradient(135deg, rgba(124, 58, 237, 0.2), rgba(59, 130, 246, 0.1));
}

.mini-card.cyan {
  background: linear-gradient(135deg, rgba(34, 211, 238, 0.16), rgba(59,130,246,0.1));
}

.mini-card.gold {
  background: linear-gradient(135deg, rgba(245, 196, 81, 0.18), rgba(249,115,22,0.12));
}

.mini-card.wide {
  grid-column: span 2;
}

.photo-card {
  overflow: hidden;
}

.photo-card img {
  height: 240px;
  width: 100%;
  object-fit: cover;
}

.photo-card.tall img { height: 300px; }

.photo-copy {
  padding: 22px 20px 24px;
}

.photo-copy span {
  display: inline-block;
  margin-bottom: 8px;
  font-size: 0.72rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--violet);
  font-weight: 800;
}

.alt-bg {
  background: linear-gradient(180deg, rgba(124,58,237,0.06), rgba(255,255,255,0.88));
}

.community-layout {
  display: grid;
  grid-template-columns: 1fr 0.95fr;
  gap: 36px;
  align-items: center;
}

.stat-pairs {
  display: grid;
  grid-template-columns: repeat(2, minmax(0,1fr));
  gap: 16px;
  margin-top: 26px;
}

.mini-pill {
  border-radius: 22px;
  padding: 20px;
  background: rgba(255,255,255,0.8);
  border: 1px solid rgba(148,163,184,0.18);
}

.mini-pill strong {
  display: block;
  font-size: 2.2rem;
  color: var(--violet);
  letter-spacing: -0.06em;
  margin-bottom: 8px;
}

.mini-pill span {
  color: var(--ink);
  font-weight: 600;
}

.quote-box {
  background: rgba(15,23,42,0.96);
  color: var(--white);
  border-radius: 28px;
  padding: 28px;
  box-shadow: var(--shadow);
}

.quote-head {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 18px;
}

.quote-mark {
  width: 46px;
  height: 46px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--violet), var(--royal));
  color: var(--white);
  font-size: 1.2rem;
}

.quote-head span {
  display: block;
  font-size: 0.72rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.7);
}

.quote-head strong {
  display: block;
  font-size: 1.55rem;
  line-height: 1.2;
  letter-spacing: -0.04em;
}

.quote-box p,
.quote-box em {
  color: rgba(255,255,255,0.8);
}

.quote-box em {
  display: block;
  margin-top: 22px;
  font-style: normal;
  color: rgba(255,255,255,0.72);
}

.cta-panel {
  display: grid;
  grid-template-columns: 1.5fr auto;
  align-items: center;
  gap: 24px;
  padding: 42px 32px;
  background: linear-gradient(90deg, #4c1d95, #1d4ed8 58%, #0891b2);
  border-radius: 30px;
  color: var(--white);
  box-shadow: 0 32px 78px rgba(59,130,246,0.28);
}

.cta-panel p {
  color: rgba(255,255,255,0.82);
  max-width: 620px;
}

.cta-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  justify-content: flex-end;
}

.site-footer {
  background: rgba(255,255,255,0.72);
  border-top: 1px solid rgba(148,163,184,0.18);
}

.footer-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 22px 0;
  color: var(--muted);
  font-size: 0.96rem;
}

.page-hero {
  padding: 72px 0 18px;
}

.narrow-hero {
  max-width: 900px;
  text-align: center;
}

.narrow-hero h1 {
  margin-top: 12px;
  color: var(--ink);
}

.content-page {
  position: relative;
  z-index: 1;
}

.image-panel img {
  width: 100%;
  height: 420px;
  object-fit: cover;
  border-radius: 28px;
  box-shadow: var(--shadow);
}

.feature-grid {
  display: grid;
  gap: 20px;
}

.two-up {
  grid-template-columns: repeat(2, minmax(0,1fr));
}

.large-box {
  padding: 22px 20px;
  border-radius: 24px;
  border: 1px solid rgba(255,255,255,0.08);
  background: rgba(255,255,255,0.04);
}

.contact-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}

.contact-card {
  padding: 26px 24px;
}

.contact-list {
  list-style: none;
  padding: 0;
  margin: 18px 0 0;
  display: grid;
  gap: 14px;
}

.contact-form {
  display: grid;
  gap: 14px;
  margin-top: 18px;
}

.contact-form input,
.contact-form textarea {
  width: 100%;
  padding: 0.9rem 1rem;
  border-radius: 14px;
  border: 1px solid rgba(148, 163, 184, 0.25);
  background: rgba(248,250,252,0.6);
  color: var(--ink);
}

.contact-form textarea { resize: vertical; }

@media (max-width: 980px) {
  .hero,
  .split-layout,
  .community-layout,
  .cta-panel,
  .contact-layout,
  .three-up,
  .two-up {
    grid-template-columns: 1fr;
  }

  .main-nav {
    display: none;
  }

  .nav-wrap {
    border-radius: 24px;
    padding: 14px 18px;
  }

  .cta-actions {
    justify-content: flex-start;
  }
}

@media (max-width: 640px) {
  .hero {
    padding-top: 32px;
  }

  .stats,
  .stat-pairs {
    grid-template-columns: 1fr;
    display: grid;
  }

  .footer-inner {
    flex-direction: column;
    text-align: center;
  }

  .btn {
    width: 100%;
  }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .btn { transition: none; }
}




























































































































































































































